# Which model to use: local (default) or hosted.
LLM_PROVIDER=local

# Local OpenAI-compatible server on this machine (mlx_lm.server, Ollama, LM Studio, and similar).
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=

# Hosted model. Only needed when LLM_PROVIDER=hosted. Use the API key and model name from your provider.
LLM_API_KEY=
LLM_MODEL=

# Postgres used by the app (docker compose defaults).
DB_URL=jdbc:postgresql://localhost:5432/advisor
DB_USER=advisor
DB_PASSWORD=

# Java API port. 8081 avoids clashing with a local model on 8080.
SERVER_PORT=8081
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Office shown in the coach and used for referral messages.
REFERRAL_OFFICE_NAME=UMKC Office of Technology Commercialization
REFERRAL_EMAIL=ericwa@umkc.edu
REFERRAL_URL=https://ori.umkc.edu/facilities-compliance-and-commercialization/commercialization/process/submit-an-invention-disclosure.php
