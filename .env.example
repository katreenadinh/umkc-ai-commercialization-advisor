# Copy to .env. NEVER commit .env.
# --- Local LLM (default). Confirm these against your running MLX server. ---
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=
# --- Optional hosted provider (off by default; do not use for confidential research) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/advisor
DB_USER=advisor
DB_PASSWORD=
# --- Server ---
SERVER_PORT=8081
CORS_ALLOWED_ORIGIN=http://localhost:5173
# --- Referral contact. Defaults come from official pages; CONFIRM with the project team. ---
REFERRAL_OFFICE_NAME=UMKC Office of Technology Commercialization
REFERRAL_EMAIL=ericwa@umkc.edu
REFERRAL_URL=https://ori.umkc.edu/facilities-compliance-and-commercialization/commercialization/process/submit-an-invention-disclosure.php
